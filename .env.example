APP_ENV=development
APP_PORT=8081
# Di hosting (Vercel/Render) PORT otomatis dipakai bila ada.
APP_KEY=delcom_blog_secret_key_super_secure_2026_random_string_32chars

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# DB_CONNECTION: pgsql (default) atau sqlite (DB_DATABASE = path berkas / :memory:)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pabwe_p9_blog
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Gunakan "require" untuk database cloud (Neon / Supabase).
DB_SSLMODE=disable

SEARCH_ENGINE_ENDPOINT=https://delcom.org/api/v1/search
OPENAI_ENDPOINT=https://delcom.org/api/v1
OPENAI_KEY=isi-api-key
OPENAI_MODEL=isi-nama-model
