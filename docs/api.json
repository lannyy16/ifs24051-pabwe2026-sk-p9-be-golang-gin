  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Response": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "fail",
              "error"
            ]
          },
          "message": {
            "type": "string"
          },
          "data": {}
        }
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "PostRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "Teknologi",
              "Pendidikan",
              "Gaya Hidup",
              "Bisnis",
              "Opini",
              "Umum"
            ]
          },
          "excerpt": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "cover_image_path": {
            "type": "string"
          },
          "is_published": {
            "type": "boolean"
          }
        },
        "required": [
          "title",
          "content"
        ]
      },
      "GenerateRequest": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "include_web_search": {
            "type": "boolean"
          }
        },
        "required": [
          "topic"
        ]
      }
    }
  }
